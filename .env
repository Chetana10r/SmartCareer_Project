# ================= FRONTEND CONFIGURATION =================
FRONTEND_URL=http://localhost:3000

# ================= FILE UPLOAD CONFIGURATION =================
MAX_UPLOAD_SIZE=5242880  # 5MB
UPLOAD_FOLDER=uploads/resumes
