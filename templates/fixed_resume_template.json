{
  "template_name": "Professional Clean Format",
  "version": "2.0",
  "description": "Clean, ATS-friendly resume format based on Chetana's layout",

  "layout_settings": {
    "page_size": "A4",
    "margins": {
      "top": 0.6,
      "bottom": 0.6,
      "left": 0.75,
      "right": 0.75
    },
    "line_spacing": 1.15,
    "section_spacing": 0.15
  },

  "typography": {
    "fonts": {
      "name": "Helvetica-Bold",
      "heading": "Helvetica-Bold",
      "subheading": "Helvetica-Bold",
      "body": "Helvetica",
      "emphasis": "Helvetica-Bold"
    },
    "sizes": {
      "name": 16,
      "contact": 10,
      "section_header": 12,
      "subheading": 11,
      "body": 10,
      "small": 9
    }
  },

  "colors": {
    "primary": "#000000",
    "text": "#000000",
    "background": "#FFFFFF"
  },

  "sections": [
    {
      "name": "header",
      "order": 1,
      "required": true,
      "style": "left_aligned",
      "formatting": {
        "name_bold": true,
        "contact_inline": true,
        "contact_separator": "  ",
        "show_email_label": true,
        "show_location_label": true
      }
    },
    {
      "name": "education",
      "order": 2,
      "required": true,
      "style": "bullet_list",
      "formatting": {
        "header_text": "Education",
        "show_institution_first": true,
        "show_location": true,
        "show_cgpa": true,
        "date_format": "MMM YYYY",
        "bullet_style": "•",
        "sub_bullet_style": "◦"
      }
    },
    {
      "name": "projects",
      "order": 3,
      "required": true,
      "style": "bullet_list_detailed",
      "max_projects": 10,
      "formatting": {
        "header_text": "Projects",
        "show_tech_stack_inline": true,
        "bullet_style": "•",
        "sub_bullet_style": "◦",
        "max_bullets": 6
      }
    },
    {
      "name": "research",
      "order": 4,
      "required": false,
      "style": "bullet_list_detailed",
      "formatting": {
        "header_text": "Research",
        "bullet_style": "•",
        "sub_bullet_style": "◦"
      }
    },
    {
      "name": "technical_skills",
      "order": 5,
      "required": true,
      "style": "categorized_bullets",
      "formatting": {
        "header_text": "Technical Skills",
        "bullet_style": "•",
        "category_separator": ": ",
        "skill_separator": ", "
      }
    },
    {
      "name": "certifications",
      "order": 6,
      "required": false,
      "style": "bullet_list",
      "formatting": {
        "header_text": "Certifications",
        "bullet_style": "•",
        "show_year": true,
        "separator": ": "
      }
    },
    {
      "name": "achievements",
      "order": 7,
      "required": false,
      "style": "bullet_list",
      "formatting": {
        "header_text": "Achievements and Roles",
        "bullet_style": "•"
      }
    },
    {
      "name": "experience",
      "order": 8,
      "required": false,
      "style": "bullet_list_detailed",
      "formatting": {
        "header_text": "Work Experience",
        "bullet_style": "•",
        "sub_bullet_style": "◦",
        "show_company_location": true
      }
    }
  ],

  "formatting_rules": {
    "section_headers": {
      "style": "bold",
      "decoration": "none",
      "spacing_before": 0.15,
      "spacing_after": 0.1
    },
    "bullet_points": {
      "primary_symbol": "•",
      "secondary_symbol": "◦",
      "indent_primary": 0.2,
      "indent_secondary": 0.4,
      "spacing": 0.08
    },
    "contact_info": {
      "phone_format": "+XX-XXXXXXXXXX",
      "email_prefix": "Email: ",
      "location_prefix": "Location: ",
      "link_style": "plain"
    }
  }
}